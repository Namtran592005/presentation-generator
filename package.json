{
  "name": "presentation-generator",
  "version": "1.0.0",
  "description": "AI-powered slide generator that converts .md, .pdf, .docx, .xlsx into professional PowerPoint presentations with animations",
  "main": "src/agent-core.js",
  "bin": {
    "ppt-agent": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "watch": "node src/cli.js --watch",
    "process": "node src/agent-core.js"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.6.0",
    "docx": "^8.5.0",
    "xlsx": "^0.18.5",
    "pptxgenjs": "^3.12.0",
    "openai": "^4.28.0",
    "zod": "^3.22.4",
    "dotenv": "^16.4.5",
    "chokidar": "^3.6.0",
    "color-convert": "^2.0.1",
    "commander": "^12.0.0"
  },
  "keywords": ["presentation", "powerpoint", "ppt", "slides", "ai", "generator"],
  "license": "MIT"
}
